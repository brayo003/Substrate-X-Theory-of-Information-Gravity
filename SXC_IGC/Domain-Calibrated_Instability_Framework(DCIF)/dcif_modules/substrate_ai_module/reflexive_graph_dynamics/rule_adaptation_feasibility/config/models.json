  "selection": {
    "adaptive_priority": "currently violated constraint types first, then UCB score",
    "soft_eval_cap": 10,
    "hard_eval_cap": 30,
    "no_harm_rule": "an adaptive/greedy model never applies an edit with negative predicted delta"
  }
