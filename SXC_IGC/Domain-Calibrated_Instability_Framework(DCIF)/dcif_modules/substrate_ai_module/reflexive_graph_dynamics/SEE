# Minimal Reflexive Rule-Engine Skeleton

class ReflexiveSystem:
    def __init__(self, initial_state: list[str]):
        # The state IS the list of active patterns and rules combined
        self.state = initial_state

    def step(self):
        # 1. State-space distinctions determine allowed transitions
        active_rules = self.extract_rules_from_state()
        
        # 2. Transitions modify the state AND the rules simultaneously
        for rule_pattern, replacement in active_rules:
            if rule_pattern in self.state:
                print(f"Applying Rule: {rule_pattern} -> {replacement}")
                self.state.remove(rule_pattern)
                self.state.extend(replacement)
                break  # State changed, re-evaluate dynamics

    def extract_rules_from_state(self):
        # Parses the state to find elements acting as transition operators
        rules = []
        for item in self.state:
            if item.startswith("RULE:"):
                # Format: "RULE:MatchPattern->NewPattern1,NewPattern2"
                _, payload = item.split(":")
                lhs, rhs = payload.split("->")
                rules.append((lhs, rhs.split(",")))
        return rules

# --- Execution Simulation ---
# Initial state contains Data ('A') and a Rule that creates both Data ('B') and a NEW Rule!
system = ReflexiveSystem([
    "A", 
    "RULE:A->B,RULE:B->C,RULE:C->CREATE_DIMENSION"
])

# Step 1: Rule converts 'A' into 'B' and introduces a new rule governing 'B'
system.step() 

# Step 2: The system now obeys a rule that DID NOT EXIST at step 0
system.step()

